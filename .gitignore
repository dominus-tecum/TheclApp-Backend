# Replace entire .gitignore with proper version
cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Node.js/React Native
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.expo/
dist/
build/
*.tgz

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Database
*.db
*.sqlite3

# Logs
*.log

# Environment variables
.env.local
.env.production

# Temporary files
temp/
tmp/

# Machine Learning models & data (CRITICAL - ADDED)
*.h5
*.keras
*.pkl
*.model
*.pth
*.pt
*.joblib
checkpoints/
logs/
*.tfevents.*
training_history_*.json
training_config_*.json
model_summary_*.txt
post_train_test_picture/
*.jpg
*.jpeg
*.png
*.docx
~$*.docx  # Temporary Word files

# Frontend files in backend (if accidentally added)
package-lock.json
package.json

# Large datasets
datasets/
data/
*.csv
*.parquet
*.feather
EOF